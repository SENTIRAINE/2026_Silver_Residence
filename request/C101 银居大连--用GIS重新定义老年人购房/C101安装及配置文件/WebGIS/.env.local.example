# Copy to .env.local for local development. Never commit real token values.
LANGGRAPH_ENABLED=false
LANGGRAPH_BASE_URL=http://127.0.0.1:8000
LANGGRAPH_SERVICE_TOKEN=replace-with-independent-random-token
AGENT_TOOL_SERVICE_TOKEN=replace-with-independent-random-token

# Shared development runtime policy.
AGENT_MAX_RUN_DURATION_MS=180000
AGENT_EVENT_RETENTION_MS=86400000
AGENT_HEARTBEAT_INTERVAL_MS=15000
SPRING_MVC_ASYNC_TIMEOUT_MS=210000

# GeoScene query budget: main query < Tool < Run < Spring MVC async timeout.
GEOSCENE_READ_TIMEOUT_MS=90000
GEOSCENE_COUNT_TIMEOUT_MS=10000
AGENT_TOOL_TIMEOUT_MS=120000
